# .env 양식: 이 파일을 .env로 복사한 뒤 값을 채웁니다. (.env는 커밋 금지)
# 항목 기준: 기능명세서 v4 load_settings()
# 값이 비어 있는 항목은 아직 정해지지 않은 값입니다. 정한 뒤 이 파일도 함께 고쳐 주세요.

# =========================================
# API 키
# =========================================
OPENAI_API_KEY=your_openai_api_key_here
# 한국은행 ECOS (문서 수치 검증·환율 패널·통계 용어)
ECOS_API_KEY=your_ecos_api_key_here
# 한국수출입은행 (토큰 비용 원화 환산용 실시간 환율)
KOREAEXIM_API_KEY=your_koreaexim_api_key_here

# =========================================
# MySQL (로컬 실행 기준: README의 'DB 준비'를 먼저 진행)
# =========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=hyb_db

# =========================================
# Chroma
# =========================================
# persistent = 로컬 폴더(CHROMA_PERSIST_PATH)에 저장 (로컬 실행 기본값)
# http = 서버 연결. 이때는 CHROMA_HOST·CHROMA_PORT·CHROMA_USER·CHROMA_PASSWORD가 필요
CHROMA_MODE=persistent
# CHROMA_HOST=your_chroma_host
# CHROMA_PORT=8000
CHROMA_PERSIST_PATH=chroma_db/
CHROMA_COLLECTION=hri_reports

# =========================================
# 모델·단가
# =========================================
LLM_MODEL=gpt-4.1
OPENAI_LLM_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHROMA_COLLECTION=hri_reports_test
# 모델별 1M 토큰당 USD 단가 (JSON 한 줄, 작은따옴표로 감쌈)
# 모델 이름은 LLM_MODEL·VISION_MODEL과 같게 쓰고, null은 OpenAI 가격표 확인 후 숫자로 바꿉니다.
MODEL_PRICES='{"gpt-6-luna": {"input": 0.1, "output": 0.5}, "gpt-4.1": {"input":2, "output": 8}}'

# =========================================
# 업로드 한도
# =========================================
MAX_MB=30
MAX_PAGES=150

# =========================================
# OCR·차트
# =========================================
OCR_LANGS=ko,en
OCR_MIN_CONF=0.4
CHART_DPI=200
MIN_CHART_PT=120

# =========================================
# 검색
# =========================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
THRESHOLD=0.3
# MMR(화면에서 켤 때) 관련도 비중 0~1. 1 = 관련도만(MMR 끈 것과 같음), 낮을수록 서로 다른 근거를 고름. 비우면 0.5
MMR_LAMBDA=0.5
# 섹션당 근거 문맥 최대 글자 수 (비우면 제한 없음)
MAX_CONTEXT_CHARS=8000

# =========================================
# 그래프
# =========================================
GRAPH_RECURSION_LIMIT=8

# =========================================
# 관리자 계정 (선택)
# =========================================
# 둘 다 있으면 앱 시작 시 관리자 계정을 한 번만 만듭니다. 쓰려면 주석을 풉니다.
# ADMIN_ID=your_admin_id
# ADMIN_PASSWORD=your_admin_password

# =========================================
# LangSmith 추적 (선택)
# =========================================
# 둘 다 있을 때만 추적을 켭니다. 쓰려면 주석을 풉니다.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key
